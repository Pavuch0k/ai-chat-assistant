FROM python:3.11-slim

WORKDIR /app

# Установка системных зависимостей
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    shadowsocks-libev \
    && rm -rf /var/lib/apt/lists/*

# Обновление pip
RUN pip install --upgrade pip

# Копируем только requirements для кэширования слоя зависимостей
COPY requirements.txt .
# Устанавливаем PyTorch CPU-only ПЕРЕД остальными зависимостями
# Это предотвращает установку CUDA версии через sentence-transformers
RUN pip install --no-cache-dir torch==2.0.1 torchvision==0.15.2 torchaudio==2.0.2 --index-url https://download.pytorch.org/whl/cpu
# Устанавливаем остальные зависимости (torch уже установлен, поэтому не переустановится)
RUN pip install --no-cache-dir -r requirements.txt

# Копируем код приложения
COPY . .

# Создаем директорию для загрузок
RUN mkdir -p uploads

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
